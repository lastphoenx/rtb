[Unit]
Description=USB-Spiegel für /srv/pcloud-archive/manifests (täglich nach Pipeline)

[Timer]
# 10:30 Puffer nach 04:00-RTB/Pipeline (kann mehrere Stunden dauern); 22:15 nach 20:00
OnCalendar=*-*-* 10:30:00
OnCalendar=*-*-* 22:15:00
Persistent=true
Unit=pcloud-manifests-backup.service

[Install]
WantedBy=timers.target
